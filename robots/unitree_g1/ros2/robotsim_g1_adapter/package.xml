<?xml version="1.0"?>
<package format="3">
  <name>robotsim_g1_adapter</name>
  <version>0.1.0</version>
  <description>G1 SDK2 to topology-independent RobotSim ROS 2 adapter.</description>
  <maintainer email="maintainers@robotsim.local">RobotSim maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>robotsim_core</depend>
  <depend>robotsim_interfaces</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
