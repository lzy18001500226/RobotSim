{
  "description": "Optional RobotSim tool guard and local Codex turn notification.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent/pre_tool_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking for destructive Git operations and credential leakage"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent/notify_task.py\" stop",
            "timeout": 12,
            "statusMessage": "Sending best-effort Codex turn notification"
          }
        ]
      }
    ]
  }
}
